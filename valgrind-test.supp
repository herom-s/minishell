# General allocations in forked pipe/subshell children
{
   pipe_child_allocations
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   fun:eval_pipe_recursive
   ...
}

{
   subshell_child_allocations
   Memcheck:Leak
   match-leak-kinds: definite,indirect
