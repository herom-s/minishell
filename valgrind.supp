# Readline leaks
{
   readline_add_history
   Memcheck:Leak
   ...
   fun:add_history
   ...
}
{
   readline_internal
   Memcheck:Leak
   ...
   fun:readline
   ...
}

# cmocka internal allocations
{
   cmocka_internal_calloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:calloc
   fun:libc_calloc
   fun:_cmocka_run_group_tests
   ...
}

# tester token creation
{
   test_io_file_token_in_fork
   Memcheck:Leak
   match-leak-kinds: definite
   fun:calloc
   fun:create_io_file_node
   ...
}